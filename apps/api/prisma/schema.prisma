generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  roleId       Int        @map("role_id")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  passwordResetTokens PasswordResetToken[]
  jobs                Job[]
  companies           Company?
  userProfile         userProfile?
  // Due to Prisma limitation, we cannot enforce the rule of: "Each User must have one UserProfile"
  // What we can enforce, is commented at model userProfile.
  userJobPreference   userJobPreference?
  resumes             Resume[]
  applications        Application[]
  logs                Log[]

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users User[]

  @@map("roles")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  users User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Job {
  id                  String         @id @default(uuid())
  createdByEmployerId String         @map("created_by_employer_id")
  companyId           String         @map("company_id")
  title               String
  description         String
  requirement         String
  employmentType      EmploymentType @map("employment_type")
  location            String
  status              JobStatus
  deadline            DateTime
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  closedAt            DateTime?      @map("closed_at")
  approvedAt          DateTime?      @map("approved_at")
  rejectedAt          DateTime?      @map("rejected_at")
  rejectionReason     String?        @map("rejection_reason")
  deletedAt           DateTime?      @map("deleted_at")
  deletionReason      String?        @map("deletion_reason")

  createdByEmployer User          @relation(fields: [createdByEmployerId], references: [id])
  company           Company       @relation(fields: [companyId], references: [id])
  applications      Application[]

  @@map("jobs")
}

model Company {
  id              String   @id @default(uuid())
  ownerEmployerId String   @unique @map("owner_employer_id")
  name            String
  district        String?
  city            String
  description     String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ownerEmployer User  @relation(fields: [ownerEmployerId], references: [id])
  jobs          Job[]

  @@map("companies")
}

model userProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  fullName    String?   @map("full_name")
  dateOfBirth DateTime? @map("date_of_birth")
  headline    String?
  summary     String?
  phoneNumber String?   @map("phone_number")
  city        String?
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  // We can enfore that:
  // "Each userProfile must belong to only one user"
  // "Each user can have at most one userProfile"
  // Both of these are enforcable since userId is unique

  @@map("user_profiles")
}

model userJobPreference {
  id                String            @id @default(uuid())
  userId            String            @unique @map("user_id")
  profileVisibility ProfileVisibility @default(VISIBLE_TO_EMPLOYERS) @map("profile_visibility")
  jobSearchStatus   JobSearchStatus   @default(OPEN_TO_WORK) @map("job_search_status")
  desiredJobTitle   String?           @map("desired_job_title")
  preferredLocation String?           @map("preffered_location")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_job_preferences")
}

model Resume {
  id         String         @id @default(uuid())
  userId     String
  title      String
  fileUrl    String         @map("file_url")
  fileType   ResumeFileType @map("file_type")
  fileSize   Int            @map("file_size")
  uploadedAt DateTime       @default(now()) @map("uploaded_at")
  deletedAt  DateTime?      @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id])
  applications Application[]

  @@map("resumes")
}

model Application {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  jobId           String            @map("job_id")
  resumeId        String            @map("resume_id")
  status          ApplicationStatus
  appliedAt       DateTime          @default(now()) @map("applied_at")
  underReviewAt   DateTime?         @map("under_review_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  decidedAt       DateTime?         @map("decided_at")
  rejectionReason String?           @map("rejection_reason")
  withdrawnAt     DateTime?         @map("withdrawn_at")

  user   User   @relation(fields: [userId], references: [id])
  job    Job    @relation(fields: [jobId], references: [id])
  resume Resume @relation(fields: [resumeId], references: [id])

  @@unique([userId, jobId])
  @@map("applications")
}

model Log {
  id         String        @id @default(uuid())
  actorId    String?       @map("actor_id")
  action     LogAction
  targetType LogTargetType @map("target_type")
  targetId   String?       @map("target_id")
  message    String
  level      LogLevel
  createdAt  DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
  @@map("logs")
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum EmploymentType {
  ON_SITE
  REMOTE
  HYBRID
}

enum JobStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  CLOSED
  EXPIRED
  DELETED
}

enum ProfileVisibility {
  PRIVATE
  VISIBLE_TO_EMPLOYERS
}

enum JobSearchStatus {
  OPEN_TO_WORK
  NOT_LOOKING
}

enum ResumeFileType {
  PDF
  DOC
  DOCX
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum LogTargetType {
  USER
  JOB
  APPLICATION
  RESUME
  COMPANY
  AUTH
  SYSTEM
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum LogAction {
  // User / Authentication
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  USER_LOGIN_FAILED
  USER_BANNED
  USER_UNBANNED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED

  // Company
  COMPANY_CREATED
  COMPANY_UPDATED

  // Job
  JOB_CREATED
  JOB_UPDATED
  JOB_APPROVED
  JOB_REJECTED
  JOB_REOPENED
  JOB_CLOSED
  JOB_DELETED
  JOB_EXPIRED

  // Application
  APPLICATION_SUBMITTED
  APPLICATION_UNDER_REVIEW
  APPLICATION_STATUS_UPDATED
  APPLICATION_WITHDRAWN

  // Resume
  RESUME_UPLOADED
  RESUME_DELETED

  // Profile
  PROFILE_UPDATED
  AVATAR_CHANGED
  JOB_PREFERENCE_UPDATED

  // System
  SYSTEM_ERROR
}
